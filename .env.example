# Набор compose-файлов: titan (Traefik) или дома (порт 8080)
COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Домен и публичный адрес (по нему Pi качает mp3 и ответы)
KS_HOST=ks.dameni.org
PUBLIC_BASE_URL=https://ks.dameni.org

# Basic-auth на весь хост (Traefik). Сгенерировать:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB speaker 'пароль'
# Значение — в одинарных кавычках: bcrypt содержит символы $
BASIC_AUTH_USERS='speaker:$2y$05$...'

# Токен админки (/admin/*, подмена говорящего в /text). Пусто — админка выключена.
#   openssl rand -hex 24
ADMIN_TOKEN=

# Необязательный второй слой: токен устройства в заголовке X-Token
# (обязателен в варианте «дома», где нет basic-auth)
GATEWAY_TOKEN=

# Какие device_id пускать к агенту (через запятую). Пусто — любые.
ALLOWED_DEVICES=kids-room,test

# Модель: haiku — быстрее и дешевле, sonnet — умнее
CLAUDE_MODEL=claude-haiku-5-5
# Сколько секунд ждём ответ Claude на одну реплику
AGENT_TURN_TIMEOUT=30
# Глубина «обдумывания» (low|medium|high); пусто — по умолчанию модели (рекомендуется)
AGENT_EFFORT=
# «стоп», «потише», «продолжай»... — сразу в шлюзе, без Claude (0 — выключить)
QUICK_COMMANDS=1
# Через сколько секунд тишины начинать новый разговор
SESSION_IDLE_SEC=600
# Сколько дней хранить логи разговоров (data/logs)
LOG_RETENTION_DAYS=30

# Whisper на CPU: base — быстрее, small — точнее
WHISPER_MODEL=small
WHISPER_THREADS=4
STT_CPUS=4

# Голос Piper и темп (больше 1 — медленнее, детям так понятнее)
PIPER_VOICE=ru_RU-irina-medium
PIPER_LENGTH_SCALE=1.1

# MySQL (openssl rand -hex 16)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

TZ=Europe/Belgrade
