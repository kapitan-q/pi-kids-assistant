# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Адрес сервера в локальной сети, как его видит Pi (по нему Pi качает mp3 и ответы)
PUBLIC_BASE_URL=http://192.168.1.50:8080

# Необязательный токен: Pi шлёт его в заголовке X-Token
GATEWAY_TOKEN=

# Модель: haiku — быстрее и дешевле, sonnet — умнее
CLAUDE_MODEL=claude-haiku-5-5

# Whisper на CPU: base — быстрее, small — точнее
WHISPER_MODEL=small
WHISPER_THREADS=4

# Голос Piper и темп (больше 1 — медленнее, детям так понятнее)
PIPER_VOICE=ru_RU-irina-medium
PIPER_LENGTH_SCALE=1.1

# MySQL
MYSQL_PASSWORD=tales
MYSQL_ROOT_PASSWORD=change-me

# Через сколько секунд тишины начинать новый разговор
SESSION_IDLE_SEC=600
