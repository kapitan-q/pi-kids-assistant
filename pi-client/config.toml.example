[server]
url = "https://ks.dameni.org"      # PUBLIC_BASE_URL сервера
user = "speaker"                     # basic-auth (Traefik); пусто — без basic-auth
password = ""
token = ""                           # GATEWAY_TOKEN, если задан (обязателен в варианте «дома»)
timeout = 45                         # сколько ждать ответа сервера, с
device_id = "kids-room"

[wakeword]
# Готовые модели openWakeWord (английские): hey_jarvis, alexa, hey_mycroft, hey_rhasspy.
# Или путь к своей .onnx-модели.
model = "hey_jarvis"
threshold = 0.5      # ложные срабатывания — повысь до 0.6–0.7; не слышит — понизь

[audio]
mic = ""                    # пусто = по умолчанию; номер или часть имени из `python -m sounddevice`
# Микрофон по сети вместо USB: старый телефон с приложением IP Webcam.
# Если задано — mic игнорируется.
stream_url = ""             # например "http://192.168.1.60:8080/audio.wav"
vad_aggressiveness = 2      # 0..3: выше — строже отсекает шум
end_silence_ms = 900        # пауза, после которой фраза считается законченной
no_speech_timeout_sec = 4   # молчат после сигнала — отбой
max_record_sec = 10

[player]
default_volume = 50
fade_sec = 20               # плавное затухание перед автостопом ночью

[bluetooth]
speaker_mac = ""            # MAC Станции Лайт — для автопереподключения

[dialog]
# После ответа колонка ещё слушает без слова активации — можно сразу спросить «а почему?».
# Только для разговора: после включения сказки, команд и в блокирующих режимах не слушает.
follow_up_sec = 6           # сколько ждать продолжения; 0 — выключить
max_follow_ups = 5          # сколько реплик подряд без слова активации
expect_reply_sec = 10       # сколько ждать, когда колонка сама задала вопрос (знакомство)
follow_up_tone = true       # тихий сигнал «слушаю дальше»
echo_guard_ms = 400         # пауза после ответа, чтобы не записать его хвост из Bluetooth
